# PostgreSQL
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
MAIN_DB_NAME=uhpcviet
MAIN_DB_PORT=5432

# Application ports
COMPOSE_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Set both admin credentials before starting the application
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set true when the site is served over HTTPS; use false only for local development
SESSION_COOKIE_SECURE=false

# MinIO server administrator credentials (used for bucket setup)
MINIO_ROOT_USER=your_minio_username
MINIO_ROOT_PASSWORD=your_minio_password

# MinIO backend service account (grant object-write access to the bucket)
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# MinIO S3 API connection and public image URLs
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_BUCKET=uhpcviet-products
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000
